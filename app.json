{
  "expo": {
    "name": "FitHash",
    "slug": "fithash",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fithash.app"
    },
    "android": {
      "package": "com.fithash.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "b2a5d62a-eb97-4583-9b41-20f7285d37c1"
      }
    },
    "owner": "ahasdemirs-team",
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#C6F035",
          "defaultChannel": "default"
        }
      ],
      "react-native-health-connect"
    ]
  }
}
